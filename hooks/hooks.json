{
  "description": "Remind Claude to check its open Nosphera lessons when a session starts, and to claim a pull request right after it is opened, before it merges.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/session-lessons.js"],
            "timeout": 10,
            "statusMessage": "Adding the Nosphera lessons reminder"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/hooks/claim-pr.js"],
            "timeout": 10,
            "statusMessage": "Checking for a new pull request to claim on Nosphera"
          }
        ]
      }
    ]
  }
}
